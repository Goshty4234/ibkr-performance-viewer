# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase — Project Settings → Database → Connection string → URI (mode Transaction, port 6543)
DATABASE_URL=postgresql://postgres.xxxxx:[PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# Secret pour l'initialisation auto (choisis n'importe quel mot de passe)
SETUP_SECRET=change-moi-123
