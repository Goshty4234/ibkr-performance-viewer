# Public hostname pointing at this server (A record). Free options: DuckDNS, sslip.io (e.g. 203-0-113-7.sslip.io).
ENGINE_DOMAIN=engine.example.com

# Only logged-in users of your site can run backtests.
ENGINE_AUTH=supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Site guest mode ("Essayer sans compte"): 1 lets visitors without a session run backtests,
# limited to ENGINE_GUEST_MAX_QUEUE active jobs per IP. Leave 0 to keep the engine members-only.
ENGINE_ALLOW_GUESTS=0
ENGINE_GUEST_MAX_QUEUE=2

# Allowed site origins. Default already accepts *.vercel.app and localhost.
# Add your custom domain here if you have one:
# ENGINE_ALLOWED_ORIGINS=https://backtest.mondomaine.com

# 1 job at a time is right for 1–4 vCPU. Raise it on a bigger machine.
ENGINE_MAX_JOBS=1
ENGINE_MAX_QUEUE=20
ENGINE_RESULT_TTL_H=12
